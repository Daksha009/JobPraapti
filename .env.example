# Gemini API Key for AI resume parsing & match scoring (get free from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# Schedule timezone (used by `schedule`; application quotas reset at 00:00 UTC).
JOBPILOT_TIMEZONE=Asia/Kolkata

# ─────────────────────────────────────────────────────────────
# PLATFORM CREDENTIALS
# Login uses your regular Chrome session via: python -m jobpilot login -p <platform>.
# Workers do not submit these passwords. Prefer the dashboard vault for secrets;
# values entered here remain plaintext in this ignored local file.
# ─────────────────────────────────────────────────────────────

# 1. LinkedIn (interactive login in regular Chrome)
LINKEDIN_EMAIL=your_email@example.com
LINKEDIN_PASSWORD=your_password_here

# 2. Cutshort (Google SSO / OTP interactive login recommended)
CUTSHORT_EMAIL=your_email@example.com

# 3. Hirist (interactive login in regular Chrome)
HIRIST_EMAIL=your_email@example.com
HIRIST_PASSWORD=your_password_here

# 4. Wellfound / AngelList (Google SSO / OTP interactive login recommended)
WELLFOUND_EMAIL=your_email@example.com
WELLFOUND_PASSWORD=your_password_here

# 5. Foundit / Monster India (interactive login in regular Chrome)
FOUNDIT_EMAIL=your_email@example.com
FOUNDIT_PASSWORD=your_password_here

# 6. Glassdoor (interactive login in regular Chrome)
GLASSDOOR_EMAIL=your_email@example.com
GLASSDOOR_PASSWORD=your_password_here

# ─────────────────────────────────────────────────────────────
# DASHBOARD & SCRAPING SETTINGS
# ─────────────────────────────────────────────────────────────
DASHBOARD_PORT=5000
DASHBOARD_HOST=127.0.0.1

# Scraping delays and limits are configured in config/platforms.yaml.
# Google Chrome installed on this device is used for sign-in, automation and tests.
# Optional override for a nonstandard installation; otherwise detected automatically.
# JOBPILOT_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
